[Rewrite]
response if ${url} ~= /^https:\/\/grpc\.biliapi\.net\/bilibili\.app\.interface\.v1\.Teenagers\/ModeStatus$/i then response.body.mock("text", "AAAAABMKEQgCEgl0ZWVuYWdlcnMgAioA", 200, true)
response if ${url} ~= /^https:\/\/grpc\.biliapi\.net\/bilibili\.app\.interface\.v1\.Search\/DefaultWords$/i then response.body.mock("text", "AAAAACEaHeaQnOe0ouinhumikeOAgeeVquWJp+aIlnVw5Li7KAE=", 200, true)
response if ${url} ~= /^https:\/\/grpc\.biliapi\.net\/bilibili\.app\.(view\.v1\.View\/TFInfo|viewunite\.v1\.View\/(PlayPause|ViewEndPage))$/i then response.body.mock("text", "AAAAAAA=", 200, true)
response if ${url} ~= /^https:\/\/app\.bilibili\.com\/x\/v2\/account\/myinfo/i then response.json.jq(".data.vip|=if . !=null and .status ==0 then . + {status:1,type:2,due_date:9005270400000,role:15} else . end")
response if ${url} ~= /^https:\/\/api\.bilibili\.com\/x\/vip\/ads\/materials/i then response.json.jq("{code,message,data:{}}")

[Script]
response if ${url} ~= /^https:\/\/app\.bilibili\.com\/x\/v2\/splash\/(list|show|event\/list2)/i then script("https://github.com/zjinkee/Loon/raw/refs/heads/main/js/bilibili.js") with tag="开屏广告", timeout=10, requires_body=true
response if ${url} ~= /^https:\/\/app\.bilibili\.com\/x\/v2\/search/i then script("https://github.com/zjinkee/Loon/raw/refs/heads/main/js/bilibili.js") with tag="搜索栏", timeout=10, requires_body=true
response if ${url} ~= /^https:\/\/app\.bilibili\.com\/x\/v2\/feed\/(index\/story|index\?)/i then script("https://github.com/zjinkee/Loon/raw/refs/heads/main/js/bilibili.js") with tag="推荐视频", timeout=10, requires_body=true
response if ${url} ~= /^https:\/\/app\.bilibili\.com\/x\/resource\/show\/tab\/v2/i then script("https://github.com/zjinkee/Loon/raw/refs/heads/main/js/bilibili.js") with tag="主页Tab", timeout=10, requires_body=true
response if ${url} ~= /^https:\/\/app\.bilibili\.com\/x\/v2\/account\/(mine\?|mine\/ipad)/i then script("https://github.com/zjinkee/Loon/raw/refs/heads/main/js/bilibili.js") with tag="我的页面", timeout=10, requires_body=true
response if ${url} ~= /^https:\/\/(grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.(app\.(show\.v1\.Popular\/Index|dynamic\.v2\.Dynamic\/DynAll|view(unite)?\.v1\.View\/(View|ViewProgress|RelatesFeed|AIRelateAsync)|playurl\.v1\.PlayURL\/PlayView|playerunite\.v1\.Player\/PlayViewUnite)|polymer\.app\.search\.v1\.Search\/SearchAll|community\.service\.dm\.v1\.DM\/DmView|main\.community\.reply\.v1\.Reply\/MainList|pgc\.gateway\.player\.v2\.PlayURL\/PlayView)$/i then script("https://raw.githubusercontent.com/kokoryh/Sparkle/refs/heads/master/dist/bilibili.protobuf.response.js") with tag="视频广告", requires_body=true, binary_body_mode=true

[MitM]
hostname = app.bilibili.com,api.bilibili.com,grpc.biliapi.net
