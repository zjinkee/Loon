#!name = YouTube
#!desc = 屏蔽推荐流广告 视频播放广告 自定义关闭上传和短视频
#!icon = https://zwiftinsider.com/wp-content/uploads/2026/05/YouTube_play_button_square_2013-2017.svg.png

[Argument]
blockUpload=switch, true, tag=关闭上传区
blockShorts=switch, true, tag=关闭短视频

[Rewrite]
response if ${url} ~= /^https:\/\/[^\/]+\.googlevideo\.com\/initplayback\?.*&ack=/i then response.body.mock("text","{}",200)

[Script]
response if ${url} ~= /^https:\/\/[^\/]+\.googleapis\.com\/(youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch|config))(\?(.*))?$/i then script("https://raw.githubusercontent.com/Maasea/sgmodule/master/Script/Youtube/youtube.response.js", {${blockUpload}, ${blockShorts}}) with tag="视频广告", requires_body=true, binary_body_mode=true

[MitM]
hostname = *.googlevideo.com,youtubei.googleapis.com
