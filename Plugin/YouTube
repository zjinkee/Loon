#!name = YouTube
#!desc = 屏蔽推荐流广告 视频播放广告 自定义关闭上传和短视频
#!icon = https://zwiftinsider.com/wp-content/uploads/2026/05/YouTube_play_button_square_2013-2017.svg.png

[Argument]
blockUpload=switch, true, tag=关闭上传区
blockShorts=switch, true, tag=关闭短视频

[Rewrite]
^https:\/\/[^\/]+\.googlevideo\.com\/initplayback\?.*&ack= mock-response-body data-type=text data="{}" status-code=200

[Script]
http-response ^https:\/\/[^\/]+\.googleapis\.com\/(youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch|config))(\?(.*))?$ script-path=https://raw.githubusercontent.com/Maasea/sgmodule/master/Script/Youtube/youtube.response.js, requires-body=true, binary-body-mode=true, argument=[{blockUpload},{blockShorts}], tag=视频广告

[MitM]
hostname = *.googlevideo.com,youtubei.googleapis.com
