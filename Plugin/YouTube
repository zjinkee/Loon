#!name = YouTube
#!desc = 屏蔽推荐流广告 视频播放广告 自定义关闭上传和短视频
#!icon = https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcRwQesfH0QRKCYsH1fcKEJTc0Y4t60QL8dq7TGP2-G-ViQIjn4fjGMueW0&s=10

[Argument]
blockUpload=switch, true, tag=关闭上传区
blockShorts=switch, true, tag=关闭短视频

[Rewrite]
^https:\/\/[^\/]+\.googlevideo\.com\/initplayback\?.*&ack= mock-response-body data-type=text data="{}" status-code=200

[Script]
http-response ^https:\/\/[^\/]+\.googleapis\.com\/(youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch|config))(\?(.*))?$ script-path=https://raw.githubusercontent.com/Maasea/sgmodule/master/Script/Youtube/youtube.response.js, requires-body=true, binary-body-mode=true, argument=[{blockUpload},{blockShorts}], tag=广告处理

[MitM]
hostname = *.googlevideo.com,youtubei.googleapis.com
