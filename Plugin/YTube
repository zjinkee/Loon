#!name=YouTube
#!desc=屏蔽游览推荐广告 视频播放页广告 个性自定义参数操作
#!icon=https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcTs13IunWYw99mqlf6B5AQXo4XqmdY5_9y3-2vd2vtoTaUI_FzRvxcHInBm&s=10

[Argument]
autoHd=switch, false, true, tag=最高画质播放
jumpAhead=switch, false, true, tag=开启精彩跳转
blockGames=switch, false, true, tag=屏蔽内置游戏
blockStore=switch, false, true, tag=屏蔽商品橱窗
blockVerticalLive=switch, false, true, tag=屏蔽竖屏直播
blockUpload=switch, false, true, tag=关闭上传按钮
blockShorts=switch, false, true, tag=关闭短视频区

[Rewrite]
request if ${url} ~= /^https:\/\/s\.youtube\.com\/api\/stats\/ads/i then reject(404)
request if ${url} ~= /^https:\/\/www\.youtube\.com\/(pagead|pcs)\//i then reject(404)

[Script]
request if ${url} ~= /^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/player\/ad_break(?:\?.*)?$/i then script("https://rucu6.pages.dev/Scripts/youtube/request_gholts.js") with tag="广告插播", requires_body=true, binary_body_mode=true
request if ${url} ~= /^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback(?:\?.*)?$/i then script("https://rucu6.pages.dev/Scripts/youtube/request_gholts.js") with tag="播放初始化", requires_body=true, binary_body_mode=true
request if ${url} ~= /^https?:\/\/[\w-]+\.googlevideo\.com\/videoplayback(?:\?.*)?$/i then script("https://rucu6.pages.dev/Scripts/youtube/request_gholts.js", {${autoHd}}) with tag="画质处理", requires_body=true, binary_body_mode=true

response if ${url} ~= /^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(?:navigation\/resolve_url|browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch)(?:\?.*)?$/i then script("https://rucu6.pages.dev/Scripts/youtube/response_gholts.js", {${autoHd}, ${blockGames}, ${blockShorts}, ${blockStore}, ${blockUpload}, ${blockVerticalLive}, ${jumpAhead}}) with tag="广告与界面过滤", requires_body=true, binary_body_mode=true
response if ${url} ~= /^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(?:config|log_event)(?:\?.*)?$/i then script("https://rucu6.pages.dev/Scripts/youtube/key_gholts.js") with tag="配置与事件处理", requires_body=true, binary_body_mode=true
response if ${url} ~= /^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback(?:\?.*)?$/i then script("https://rucu6.pages.dev/Scripts/youtube/ump_gholts.js", {${autoHd}, ${blockGames}, ${blockStore}, ${blockVerticalLive}, ${jumpAhead}}) with tag="播放数据处理", requires_body=true, binary_body_mode=true

[MITM]
hostname = s.youtube.com,www.youtube.com,rr*.googlevideo.com,youtubei.googleapis.com
